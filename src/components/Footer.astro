---
const socialLinks = [
  { label: 'GitHub', href: 'https://github.com/adrianrojas', icon: 'github' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/rojasadriane/', icon: 'linkedin' },
  { label: 'Web', href: 'https://adrianrojas.dev', icon: 'globe' },
];

const today = new Date();
---

<footer>
  <div class="footer-content">
    <div class="footer-brand">
      <span class="brand">adrotech</span>
      <p class="tagline">Construir, automatizar y compartir conocimiento abierto.</p>
    </div>
    <div class="social-links">
      {socialLinks.map((link) => (
        <a href={link.href} target="_blank" rel="noopener noreferrer" class="social-link">
          {link.icon === 'github' && <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.235 1.839 1.235 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>}
          {link.icon === 'linkedin' && <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>}
          {link.icon === 'globe' && <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.627 0-12 5.373-12 12s5.373 12 12 12 12-5.373 12-12-5.373-12-12-12zm-1 19.5h-2v-6h2v6zm8-6c0 .885-.278 1.721-.748 2.373l-1.368-1.392c.234-.425.364-.919.364-1.456 0-1.477-1.164-2.686-2.748-2.686-.462 0-.905.116-1.295.329l-1.086-1.436c.576-.336 1.253-.536 1.965-.536 2.073 0 3.818 1.514 4.134 3.604h1.682zm-3.5-7.5c0 .885.278 1.721.748 2.373l1.368-1.392c-.234-.425-.364-.919-.364-1.456 0-1.477 1.164-2.686 2.748-2.686.462 0 .905.116 1.295.329l1.086-1.436c-.576-.336-1.253-.536-1.965-.536-2.073 0-3.818 1.514-4.134 3.604h-1.682z"/></svg>}
          <span class="sr-only">{link.label}</span>
        </a>
      ))}
    </div>
  </div>
  <p class="copyright">© {today.getFullYear()} adrotech · Adrian Rojas</p>
</footer>

<style>
	footer {
		width: min(1100px, calc(100% - 2rem));
		margin: 3rem auto 2rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--border);
	}

	.footer-content {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: 1.5rem;
		margin-bottom: 1.5rem;
	}

	.brand {
		font-weight: 700;
		font-size: 1.1rem;
		color: var(--text);
	}

	.tagline {
		margin: 0.35rem 0 0;
		color: var(--text-faint);
		font-size: 0.9rem;
	}

	.social-links {
		display: flex;
		gap: 1rem;
	}

	.social-link {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 48px;
		height: 48px;
		border-radius: 12px;
		background: var(--bg-card);
		border: 1px solid var(--border);
		color: var(--text-dim);
		transition: all 0.25s ease;
	}

	.social-link:hover {
		color: var(--text);
		border-color: var(--accent);
		transform: translateY(-3px);
		box-shadow: 0 8px 24px rgba(34, 211, 238, 0.15);
	}

	.social-link svg {
		width: 22px;
		height: 22px;

	.copyright {
		margin: 0;
		color: var(--text-faint);
		font-size: 0.85rem;
		text-align: center;
	}

	@media (max-width: 640px) {
		.footer-content {
			flex-direction: column;
			align-items: center;
			text-align: center;
		}
	}
</style>
